# Copy to .env (never commit .env). Existing environment variables take precedence.

# Claude API
ANTHROPIC_API_KEY=sk-ant-...
# Needed only if the key is not scoped to a workspace (Claude Console > Workspaces).
ANTHROPIC_WORKSPACE_ID=
# Model for extraction, reconciliation and digests (overridable in .essence/config.toml).
ESSENCE_ANTHROPIC_MODEL=claude-sonnet-5-5

# Passphrase for the SQLCipher-encrypted index ([index] encrypt = true).
ESSENCE_DB_KEY=

# Bearer token for `essence serve --http` (generated into .essence/mcp_token if unset).
ESSENCE_MCP_TOKEN=
